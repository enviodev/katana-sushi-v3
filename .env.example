# HyperSync API token — required by HyperIndex v3.
# Get one for free at https://envio.dev
ENVIO_API_TOKEN=

# dRPC key — used by Effect API for token metadata, position info,
# pool fee growth, and pool tick fee growth lookups.
# Get one at https://drpc.org
ENVIO_DRPC_API_KEY=

# Optional override for the Katana RPC endpoint used by viem.
# Defaults to a public RPC if unset.
ENVIO_KATANA_RPC_URL=

# Set to "true" to enable RPC calls that populate fee-growth fields
# (Pool.feeGrowthGlobal*X128 and Tick.feeGrowthOutside*X128). Required for
# downstream consumers doing LP fee accounting. When unset, those fields stay
# at zero and backfill is ~10x faster.
ENVIO_FETCH_FEE_GROWTH=
