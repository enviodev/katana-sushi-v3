# HyperSync API token — required by HyperIndex v3.
# Get one for free at https://envio.dev
ENVIO_API_TOKEN=

# Katana RPC endpoint — used by the Effect API for token metadata, position
# info, pool fee growth, and pool tick fee growth lookups. Also wired into
# config.yaml as a fallback RPC source for the indexer itself.
# Defaults to the public Katana RPC if unset; a dedicated provider
# (e.g. dRPC, Alchemy, Ankr) is recommended for backfill throughput.
ENVIO_KATANA_RPC_URL=

# Controls RPC calls that populate the Uniswap V3 fee-growth fields:
#   - Pool.feeGrowthGlobal0/1X128
#   - Tick.feeGrowthOutside0/1X128
#   - Position.feeGrowthInside0/1LastX128
# Default ON (feature-rich, required for LP-fee accounting). Set to "false"
# or "0" to opt out and trade away the fee fields for ~10x faster backfill.
ENVIO_FETCH_FEE_GROWTH=
